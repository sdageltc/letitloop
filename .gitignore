# Orchestrator run-state artifacts (state.json, worker outputs, evidence)
# Runs are stored in scratch/ (already ignored above). These patterns
# ensure orchestrator/ source dirs don't accidentally accumulate state.
orchestrator/**/state.json
orchestrator/**/worker_brief.txt
orchestrator/**/scope_snapshot.json
orchestrator/fixtures/generated/

