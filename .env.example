# agent-loop Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# LLM Provider Configuration
# ===========================================

# Option 1: Generic OpenAI-compatible provider
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1

# Option 2: Named providers (uncomment one)
# OPENAI_API_KEY=your-openai-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key
# GEMINI_API_KEY=your-gemini-api-key
# DEEPSEEK_API_KEY=your-deepseek-api-key

# ===========================================
# Model Configuration
# ===========================================

# Default worker model (override if needed)
# WORKER_MODEL=gemini:gemini-3.6-flash

# QC reviewer model
# QC_MODEL=gemini:gemini-3.1-pro

# Planner model (defaults to WORKER_MODEL)
# PLANNER_MODEL=openai:gpt-4o-mini

# ===========================================
# Orchestrator Configuration
# ===========================================

# Run state directory
# ORCHESTRATOR_RUN_DIR=./scratch/orchestrator_runs

# Maximum worker attempts
# ORCHESTRATOR_MAX_ATTEMPTS=3

# Worker timeout in seconds
# ORCHESTRATOR_TIMEOUT=300

# Enable parallel execution
# ORCHESTRATOR_PARALLEL=false

# Maximum concurrent workers
# ORCHESTRATOR_MAX_WORKERS=3

# ===========================================
# Development Configuration
# ===========================================

# Enable debug mode
# ORCHESTRATOR_DEBUG=false

# Test configuration
# SKIP_LIVE=true
# FAKE_WORKER=1
