# let it loop (LIL) Environment Configuration
# Copy this file to .env and configure your desired providers and settings

# ===========================================
# LLM Provider Configuration
# ===========================================

# Primary LLM API Keys (uncomment the providers you use)
# GEMINI_API_KEY=your-gemini-api-key
# OPENAI_API_KEY=your-openai-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key
# DEEPSEEK_API_KEY=your-deepseek-api-key

# Gateway & Local Router Providers
# OMNIROUTE_API_KEY=your-omniroute-api-key
# OMNIROUTE_BASE_URL=http://localhost:8000/v1
# OPENROUTER_API_KEY=your-openrouter-api-key
# GROQ_API_KEY=your-groq-api-key
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Generic OpenAI-Compatible Gateway Override
# LLM_API_KEY=your-custom-gateway-key
# LLM_BASE_URL=https://api.openai.com/v1

# ===========================================
# Model Selection & Routing Configuration
# ===========================================

# Default Worker / Executor model
# WORKER_MODEL=gemini:gemini-3.6-flash

# QC Reviewer model (Code review, Security audit, Spec validation)
# QC_MODEL=gemini:gemini-3.1-pro

# DAG Planner model (Decomposes natural language into dependency contracts)
# PLANNER_MODEL=gemini:gemini-3.6-flash

# Premium Reasoning / Crucible Models (Optional for high-stakes tasks)
# REASONER_MODEL=openai:gpt-5.6-sol
# LUNA_MODEL=openai:gpt-5.6-luna
# OPUS_MODEL=anthropic:claude-opus-4-1
# SONNET_MODEL=anthropic:claude-3-7-sonnet

# ===========================================
# Worker Adapter Configuration
# ===========================================

# CLI Workers (Claude Code, Google Antigravity, OpenCode, Aider)
# CLAUDE_BINARY=claude
# AGY_BINARY=agy
# OPENCODE_BINARY=opencode

# ===========================================
# Orchestrator & Supervisor Runtime Settings
# ===========================================

# Run state and evidence directory
# ORCHESTRATOR_RUN_DIR=./scratch/orchestrator_runs

# Maximum worker retry attempts per task contract before escalation
# ORCHESTRATOR_MAX_ATTEMPTS=3

# Worker execution timeout in seconds
# ORCHESTRATOR_TIMEOUT=300

# Parallel task execution across independent DAG branches
# ORCHESTRATOR_PARALLEL=false
# ORCHESTRATOR_MAX_WORKERS=4

# ===========================================
# Diagnostic & Development Settings
# ===========================================

# Enable verbose debug logging
# ORCHESTRATOR_DEBUG=false

# Test execution simulation
# SKIP_LIVE=true
# FAKE_WORKER=1
